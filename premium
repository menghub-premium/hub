    local valid, reason = validateKey(savedKey)
    if valid and not _bypassFlagged then
        return launch(savedKey)
    end
    if reason == "banned" then
        clearKey()
        LocalPlayer:Kick("[Meng Hub]\nHWID/Key anda telah di ban!")
        return
    elseif reason ~= "server_error" then
        clearKey()
    end
end

