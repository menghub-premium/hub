-- ===== SAVED KEY (TANPA TTL) =====
local function saveKey(key)
    pcall(function() writefile(KEY_FILE, tostring(key)) end)
end

local function clearKey()
    pcall(function() if isfile and isfile(KEY_FILE) and delfile then delfile(KEY_FILE) end end)
    pcall(function() if isfile and isfile(KEY_FILE) then writefile(KEY_FILE, "") end end)
end

local function readSavedKey()
    local ok, raw = pcall(readfile, KEY_FILE)
    if not ok or not raw or raw == "" then return nil end
    local k = (tostring(raw):match("^(.-)|") or tostring(raw)):gsub("%s+", "")
    if k ~= "" then
        return k
    end
    clearKey()
    return nil
end

-- ===== VALIDASI KEY =====
local REASONS = {
    HWID_BANNED = "banned", BANNED = "banned",
    HWID_MISMATCH = "hwid_mismatch",
    KEY_EXPIRED = "expired",
    KEY_INVALID = "invalid", KEY_INVALIDATED = "invalid", ALREADY_USED = "invalid",
    SERVICE_MISMATCH = "invalid", PREMIUM_REQUIRED = "invalid",
}
local MESSAGES = {
    banned = "HWID or key has been banned!",
    hwid_mismatch = "Key bound to another device!",
    expired = "License key has expired!",
    server_error = "Server error, try again later.",
    bypass_detected = "Bypass attempt detected!",
    invalid = "Invalid key, check and try again!",
}

local function checkRawKey(key)
    if iscclosure and not iscclosure(httpRequest) then
        TriggerAntiBypass("Tampered HTTP")
        return false, "bypass_detected"
    end

    local ok, resp = pcall(httpRequest, {
        Method = "POST",
        Url = VERIFY_URL,
        Headers = {
            ["Content-Type"] = "application/json",
            ["X-Req-Verify"] = tostring(math.random(100000, 999999))
        },
        Body = _rawJSONEncode(HttpService, {
            key = tostring(key or ""),
            service = SERVICE,
            identifier = tostring(IDENTIFIER)
        }),
    })

    if not ok or not resp or type(resp) ~= "table" or resp.StatusCode ~= 200 then
        return false, "server_error"
    end

    local okD, data = pcall(_rawJSONDecode, HttpService, resp.Body)
    if not okD or type(data) ~= "table" then
        return false, "server_error"
    end

    if data.valid == true and (data.message == "KEY_VALID" or data.message == "KEYLESS") then
        if type(data.message) ~= "string" then
            TriggerAntiBypass("Malformed Payload")
            return false, "bypass_detected"
        end
        return true, "ok"
    end

    return false, REASONS[tostring(data.message or data.error or "")] or "invalid"
end

local function validateKey(key)
    if not key or key == "" then return false, "invalid" end
    if _bypassFlagged then return false, "bypass_detected" end

    for i = 1, 2 do
        local trapKey = "INVALID_TRAP_" .. HttpService:GenerateGUID(false)
        local trapValid = checkRawKey(trapKey)
        if trapValid == true or _bypassFlagged then
            TriggerAntiBypass("Fake Response Spoofing #" .. i)
            return false, "bypass_detected"
        end
    end

    return checkRawKey(key)
end

-- ===== LOAD SCRIPT GAME =====
local function launch(key)
    local scriptId = games[game.GameId] or games[game.PlaceId]
    if not scriptId then
        LocalPlayer:Kick("\nMap not supported yet!")
        return
    end

    local ok, Junkie = pcall(function()
        return loadstring(game:HttpGet("https://jnkie.com/sdk/library.lua"))()
    end)

    if not ok or type(Junkie) ~= "table" then
        warn("[Meng Hub] Gagal load Junkie SDK")
        return
    end

    Junkie.script_id = scriptId
    getgenv().SCRIPT_KEY = tostring(key)

    getgenv().MengHubAuthed = true
    getgenv().MengHubKey = key
    getgenv().MengHubIsPremium = true 

    local success, err = pcall(function()
        Junkie.load_script()
    end)

    if not success then
        warn("[Meng Hub] Gagal load script: " .. tostring(err))
        getgenv().MengHubAuthed = false
    end
end

