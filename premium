            verifyBtn.Text = "CHECKING" .. dots[idx]
            idx = (idx % #dots) + 1
            task.wait(0.3)
        end
    end)

    task.spawn(function()
        local valid, reason = validateKey(key)
        loading = false

        if valid and not _bypassFlagged then
            saveKey(key)
            verifyBtn.Text = "VERIFIED ✓"
            tween(verifyBtn, 0.2, { BackgroundColor3 = Color3.fromRGB(110, 225, 145) })
            setStatus("Key verified! Launching Meng Hub...", Color3.fromRGB(115, 230, 145))
            task.wait(0.45)
            closeUI(function()
                launch(key)
            end)
        else
            busy = false
            verifyBtn.Text = "VERIFY KEY"
            if reason == "banned" then
                clearKey()
                LocalPlayer:Kick("[Meng Hub]\nHWID/Key anda telah di ban!")
                return
            end
            shakeInput()
            setStatus(MESSAGES[reason] or MESSAGES.invalid, Color3.fromRGB(235, 100, 100))
        end
    end)
end)
